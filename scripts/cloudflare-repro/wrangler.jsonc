{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Throwaway proof Worker: fresh-clone reproduce of github.com/zaycruz/coach-copilot on Cloudflare Containers. Not production; delete after the run.
  "name": "c5-repro-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "SANDBOX_TRANSPORT": "rpc" },
  "containers": [{ "class_name": "Sandbox", "image": "docker.io/cloudflare/sandbox:0.12.10-python", "instance_type": "standard-1", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "Sandbox", "class_name": "Sandbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox"] }]
}
